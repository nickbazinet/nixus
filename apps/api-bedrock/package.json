    "esbuild": "^0.28.2",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
