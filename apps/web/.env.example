# Public site URL (used for OG tags, sitemap.xml — Story 4.x)
VITE_SITE_URL=https://nixusapp.com

# Cloudflare Web Analytics token (Story 4.1).
# Public site identifier — NOT a secret. Get one from the Cloudflare
# dashboard for the site's domain. Leave unset in dev: the beacon is only
# injected on production builds when this is set, so dev/test runs stay
# offline and cookieless.
VITE_CLOUDFLARE_ANALYTICS_TOKEN=

# Origin of the public billing API, which the /pricing page reads the live plan
# catalog from (GET /v1/billing/plans — public, unauthenticated, cacheable).
# Leave unset to use production. Point it at a Stripe test-mode deployment to
# develop against test prices; both /pricing and /fr/pricing fall back to the
# baked amounts in src/content/pricing.ts whenever this host cannot be reached,
# so an unset or wrong value degrades rather than breaks. The amounts are
# declared once and formatted per locale, so EN and FR can never disagree.
VITE_BILLING_API_URL=https://api.nixusapp.com

# Optional GitHub token for the build-time releases fetcher (Story 2.1) to
# avoid unauthenticated rate limits on CI. Public repo, so unauth works too.
# GITHUB_TOKEN=
